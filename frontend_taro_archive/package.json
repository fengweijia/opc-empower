    "@tarojs/runtime": "3.6.37",
    "@tarojs/taro": "3.6.37",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@tarojs/cli": "3.6.37",
    "babel-preset-taro": "3.6.37",
