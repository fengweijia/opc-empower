.state-feedback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}
.state-feedback .icon {
  font-size: 128rpx;
  margin-bottom: 40rpx;
}
.state-feedback .message {
  color: #F5F5F7;
  font-size: 32rpx;
  line-height: 1.6;
  margin-bottom: 48rpx;
}
.state-feedback .action-btn, .state-feedback .retry-btn {
  background: #00E5A0;
  color: #000000;
  border-radius: 16rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}
.state-feedback .action-btn:active, .state-feedback .retry-btn:active {
  transform: scale(0.95);
}
.loading-skeleton {
  padding: 40rpx;
}
.loading-skeleton .marquee-box {
  text-align: center;
  margin-bottom: 40rpx;
  height: 60rpx;
  overflow: hidden;
}
.loading-skeleton .marquee-box .marquee-text {
  color: #00E5A0;
  font-size: 28rpx;
  font-weight: bold;
  animation: fadeInOut 2s infinite;
}
.loading-skeleton .skeleton-card {
  background: #1A1A2E;
  border-radius: 32rpx;
  padding: 40rpx;
  margin-bottom: 32rpx;
  animation: pulse 1.5s infinite ease-in-out;
}
.loading-skeleton .sk-title {
  height: 48rpx;
  width: 40%;
  background: #2A2A4E;
  border-radius: 8rpx;
  margin-bottom: 32rpx;
}
.loading-skeleton .sk-line {
  height: 32rpx;
  background: #2A2A4E;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
}
.loading-skeleton .sk-line.w-100 {
  width: 100%;
}
.loading-skeleton .sk-line.w-90 {
  width: 90%;
}
.loading-skeleton .sk-line.w-80 {
  width: 80%;
}
.loading-skeleton .sk-line.w-70 {
  width: 70%;
}
.loading-skeleton .sk-line.w-60 {
  width: 60%;
}
@keyframes fadeInOut {
  0% {
    opacity: 0.5;
    transform: translateY(10rpx);
  }
  50% {
    opacity: 1;
    transform: translateY(0);
  }
  100% {
    opacity: 0.5;
    transform: translateY(-10rpx);
  }
}
@keyframes pulse {
  0% {
    opacity: 0.6;
  }
  50% {
    opacity: 1;
  }
  100% {
    opacity: 0.6;
  }
}
